# Hook commit-msg : refuse un message de commit contenant un terme interdit (voir scripts/check-repo.ps1).
cd "$(git rev-parse --show-toplevel)" || exit 1
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File scripts/check-repo.ps1 -MessageFile "$1"
else
  exec powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-repo.ps1 -MessageFile "$1"
fi
