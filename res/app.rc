// Ressources de ShaderToMP4 : icone et informations de version (onglet "Details" de l'exe)
#include <winver.h>
#include "version.h"

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,0
PRODUCTVERSION APP_VER_MAJOR,APP_VER_MINOR,APP_VER_PATCH,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040c04b0"  // francais, Unicode
        BEGIN
            VALUE "ProductName", "ShaderToMP4\0"
            VALUE "FileDescription", "Convertit des shaders Shadertoy en video MP4\0"
            VALUE "FileVersion", APP_VER_STR ".0\0"
            VALUE "ProductVersion", APP_VER_STR ".0\0"
            VALUE "InternalName", "ShaderToMP4\0"
            VALUE "OriginalFilename", "ShaderToMP4.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040c, 1200
    END
END
